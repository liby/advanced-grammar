{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly",
    ":maintainLockFilesMonthly",
    ":pinAllExceptPeerDependencies",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "description": "Automerge non-major updates",
      "groupName": "Automerge Non-major Updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "nextra's twoslash toolchain only supports TypeScript ^5.5 || ^6 (https://github.com/shuding/nextra/blob/main/packages/nextra/package.json, twoslash peerDependencies)",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ],
  "platformAutomerge": true,
  "prCreation": "immediate",
  "rangeStrategy": "auto"
}